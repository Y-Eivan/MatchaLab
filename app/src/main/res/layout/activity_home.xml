<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!--top bar-->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@color/background">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                app:tint="@color/primary"
                android:contentDescription="@string/cd_open_menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/menu_home"
                android:fontFamily="@font/inter_semibold"
                android:textSize="18sp"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnBell"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bell"
                app:tint="@color/primary"
                android:contentDescription="@string/cd_notifications" />

        </LinearLayout>

        <!--scrollable content-->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!--greeting section-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/tvTimeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/greeting_afternoon"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="26sp"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <!--carousel section-->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/viewPager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!--bottom overlay: arrows at sides, dots centered-->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_gravity="bottom">

                            <ImageButton
                                android:id="@+id/btnPrev"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="start|center_vertical"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_carousel_btn"
                                android:src="@drawable/ic_chevron_left"
                                android:contentDescription="@string/cd_previous" />

                            <LinearLayout
                                android:id="@+id/dotIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/dot0"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="4dp"
                                    android:background="@drawable/dot_active" />

                                <View
                                    android:id="@+id/dot1"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="4dp"
                                    android:background="@drawable/dot_inactive" />

                                <View
                                    android:id="@+id/dot2"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="4dp"
                                    android:background="@drawable/dot_inactive" />

                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnNext"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="12dp"
                                android:background="@drawable/bg_carousel_btn"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@string/cd_next" />

                        </FrameLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!--quick menu-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_quick_menu"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:paddingStart="4dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingBottom="6dp">

                        <!--items card-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardItems"
                            android:layout_width="0dp"
                            android:layout_height="108dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_cup"
                                        app:tint="@color/accent"
                                        android:contentDescription="@null" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/menu_items"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!--branch card-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBranch"
                            android:layout_width="0dp"
                            android:layout_height="108dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_pin"
                                        app:tint="@color/accent"
                                        android:contentDescription="@null" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/menu_branch"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!--log out card-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLogout"
                            android:layout_width="0dp"
                            android:layout_height="108dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_logout"
                                        app:tint="@color/accent"
                                        android:contentDescription="@null" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/menu_logout"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>

                <!--today's pick, hard coding this-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_todays_pick"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvSeeAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_see_all"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="13sp"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!--product card 1-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardPick1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardElevation="0dp"
                            app:rippleColor="@color/card_ripple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="150dp"
                                    android:src="@drawable/img_ceremonial_matcha"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="@null" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/product_ceremonial_name"
                                        android:fontFamily="@font/inter_semibold"
                                        android:textSize="14sp"
                                        android:textColor="@color/text_primary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/product_ceremonial_price"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="14sp"
                                        android:textColor="@color/primary" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!--product card 2-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardPick2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardElevation="0dp"
                            app:rippleColor="@color/card_ripple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="150dp"
                                    android:src="@drawable/img_matcha_iced"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="@null" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/product_iced_name"
                                        android:fontFamily="@font/inter_semibold"
                                        android:textSize="14sp"
                                        android:textColor="@color/text_primary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/product_iced_price"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="14sp"
                                        android:textColor="@color/primary" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!--sidebar thingy-->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_home"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/text_primary" />

</androidx.drawerlayout.widget.DrawerLayout>