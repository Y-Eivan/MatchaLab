<resources xmlns:tools="http://schemas.android.com/tools">
    <!--no action bar — each screen manages its own toolbar/header-->
    <style name="Theme.MatchaLab" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">#FFFFFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="fontFamily">@font/inter_regular</item>  <!--default app font-->
        <item name="android:statusBarColor">#FFFFFF</item>  <!--overridden per-activity-->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>